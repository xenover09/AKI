"""
AKI Desktop Launcher.

Starts the Qt application after the Boot Manager
has successfully completed.
"""

from __future__ import annotations

import sys

from PySide6.QtWidgets import QApplication

from desktop.main_window import MainWindow
from desktop.themes.blue_theme import BlueTheme


class DesktopApplication:
    """
    Launches the AKI desktop shell.
    """

    def __init__(self) -> None:

        self.app = QApplication(sys.argv)

        self.theme = BlueTheme()

        self.app.setApplicationName("AKI")

        self.app.setOrganizationName("Aether")

        self.app.setStyleSheet(
            self.theme.global_stylesheet()
        )

        self.window = MainWindow(self.theme)

    def run(self) -> int:
        """
        Show desktop and start Qt event loop.
        """

        self.window.show()

        return self.app.exec()