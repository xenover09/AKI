# AKI Runtime Configuration
# Copy this file to `.env` (never commit the real .env).

# --- Application ---
AKI_ENVIRONMENT=development
AKI_LOG_LEVEL=DEBUG
AKI_LOG_DIR=runtime/logs
AKI_DEBUG=true

# ============================================================
# Intelligence Layer
# ============================================================

# Provider: mock (offline, default) | openai_compatible
AKI_AI_PROVIDER=mock

# Used when AKI_AI_PROVIDER=openai_compatible.
# Any OpenAI-compatible endpoint works, for example:
#   Groq    : https://api.groq.com/openai/v1
#   OpenAI  : https://api.openai.com/v1
#   Ollama  : http://localhost:11434/v1   (set any non-empty key)
AKI_AI_BASE_URL=https://api.groq.com/openai/v1
AKI_AI_API_KEY=
AKI_AI_MODEL=llama-3.3-70b-versatile
AKI_AI_TIMEOUT_SECONDS=60
